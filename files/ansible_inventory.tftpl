[control_plane]
control-plane ansible_host=master.${domain} ansible_user=master

[workers]
%{ for worker in workers ~}
${worker} ansible_host=${worker}.${domain}
%{ endfor }

[workers:vars]
ansible_user=worker

[k8s_cluster:children]
control_plane
workers

[k8s_cluster:vars]
ansible_become=true
ansible_ssh_private_key_file=${ssh_private_key_path}
